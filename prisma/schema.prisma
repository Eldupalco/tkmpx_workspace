generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model attendances {
  id               String     @id
  userId           String
  date             String
  // Daily Time Record: one row per user per day, punched in order AM In -> AM Out -> PM In -> PM Out
  amIn             DateTime?
  amOut            DateTime?
  pmIn             DateTime?
  pmOut            DateTime?
  lateMinutes      Int        @default(0)
  undertimeMinutes Int        @default(0)
  status           String     @default("present")
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  scheduleId       String?
  schedules        schedules? @relation(fields: [scheduleId], references: [id])
  users            users      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model schedules {
  id           String        @id
  userId       String
  dayOfWeek    Int
  startTime    String
  endTime      String
  // Lunch break; both null = shift without a break (single Time In / Time Out)
  breakStart   String?       @default("12:00")
  breakEnd     String?       @default("13:00")
  // Minutes after start / break end before a punch counts as late
  graceMinutes Int           @default(0)
  shiftName    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  attendances  attendances[]
  users        users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek])
}

model users {
  id          String        @id
  name        String
  email       String        @unique
  password    String
  role        String        @default("user")
  avatarUrl   String? // <--- NEW FIELD
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  attendances attendances[]
  schedules   schedules[]
}
