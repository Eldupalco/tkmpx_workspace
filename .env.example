# ==========================================
# NestJS Backend Environment Variables
# ==========================================

# 1. Database Connection URL (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# IMPORTANT: If your password contains special characters like '@', URL-encode it (e.g. '@' becomes '%40')
DATABASE_URL="postgresql://postgres:%402020@localhost:5432/tkpex?schema=public"

# 2. Server Port (NestJS Backend runs on 3000)
PORT=3000
NODE_ENV=development

# Business timezone used for attendance dates, schedules, and punch calculations
APP_TIMEZONE=Asia/Manila

# 3. JWT Secret (REQUIRED - the app refuses to start without it)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# 4. Return the password reset token in the API response (local development only - never in production)
EXPOSE_RESET_TOKEN=false

# 5. Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3001

