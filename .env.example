# ==========================================
# NestJS Backend Environment Variables
# ==========================================

# 1. Database Connection URL (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# IMPORTANT: If your password contains special characters like '@', URL-encode it (e.g. '@' becomes '%40')
DATABASE_URL="postgresql://postgres:%402020@localhost:5432/tkpex?schema=public"

# 2. Server Port (NestJS Backend runs on 3000)
PORT=3000
NODE_ENV=development

# 3. JWT Secret (Optional override for token signing)
JWT_SECRET=supersecretjwtkeyforworkforceapp

